---
import { listOfferings, listSelections } from "../lib/db";
import Header from "../components/Header.astro";
import "../styles.css";

const offerings = listOfferings();
const timetable = listSelections();

const takenOfferingIds = new Set(timetable.map((entry) => entry.offering.id));

// Grouped by course so the sidebar can collapse to one row per course
// (native <details>/<summary>, no client JS) — offerings are already
// sorted by day/time, and grouping preserves that order within each course.
const offeringsByCourse = new Map<string, typeof offerings>();
for (const offering of offerings) {
  const list = offeringsByCourse.get(offering.courseCode) ?? [];
  list.push(offering);
  offeringsByCourse.set(offering.courseCode, list);
}

const addedId = Number(Astro.url.searchParams.get("added"));
const clashId = Number(Astro.url.searchParams.get("clash"));
const withId = Number(Astro.url.searchParams.get("with"));
const removedId = Number(Astro.url.searchParams.get("removed"));
const addedOffering = offerings.find((o) => o.id === addedId);
const clashOffering = offerings.find((o) => o.id === clashId);
const withOffering = offerings.find((o) => o.id === withId);
const removedOffering = offerings.find((o) => o.id === removedId);

const autoselected = Astro.url.searchParams.get("autoselected") === "1";
const cleared = Astro.url.searchParams.get("cleared") === "1";
const conflictCourseCodes = (Astro.url.searchParams.get("conflicts") ?? "")
  .split(",")
  .filter(Boolean);

// Every add/remove is a full page reload (progressive enhancement, no
// client JS needed), which would otherwise reset every <details> back to
// closed. Re-open whichever course group the action just touched, so
// picking a second lab option for the same course doesn't require
// re-expanding it each time.
const openCourseCode =
  addedOffering?.courseCode ?? clashOffering?.courseCode ?? removedOffering?.courseCode;

// The grid: days across, half-hour rows down. The window (09:00-18:00)
// covers the seed catalogue with headroom; a real feed would derive this
// from its own data instead of a fixed constant.
const GRID_DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri"];
const GRID_START_MINUTES = 9 * 60;
const GRID_SLOT_MINUTES = 30;
const GRID_ROWS = 18;

function timeToMinutes(time: string): number {
  const [h, m] = time.split(":").map(Number);
  return h * 60 + m;
}

// Grid line numbers are 1-based and the header row occupies line 1, so a
// session starting at the grid's first slot lands on row 2.
function timeToRow(time: string): number {
  return (timeToMinutes(time) - GRID_START_MINUTES) / GRID_SLOT_MINUTES + 2;
}

const slotLabels = Array.from({ length: GRID_ROWS }, (_, i) => {
  const minutes = GRID_START_MINUTES + i * GRID_SLOT_MINUTES;
  const h = String(Math.floor(minutes / 60)).padStart(2, "0");
  const m = String(minutes % 60).padStart(2, "0");
  return `${h}:${m}`;
});

const SESSION_ICONS: Record<string, string> = {
  Lecture: "menu_book",
  Lab: "science",
  Studio: "palette",
  Tutorial: "groups",
};
function sessionIcon(sessionType: string): string {
  return SESSION_ICONS[sessionType] ?? "event";
}

// Real numbers off the actual selections, not decoration — distinct
// courses, session count, and total contact hours via the same
// timeToMinutes used to lay out the grid. "Clash-free" is stated rather
// than counted: the app never lets a clash reach the timetable, so there's
// nothing to tally.
const distinctCourseCount = new Set(timetable.map((entry) => entry.offering.courseCode)).size;
const totalContactMinutes = timetable.reduce(
  (sum, entry) =>
    sum + (timeToMinutes(entry.offering.endTime) - timeToMinutes(entry.offering.startTime)),
  0,
);
const totalContactHours = Math.round((totalContactMinutes / 60) * 10) / 10;

// Same data as the grid, grouped by day for the agenda list beside it — a
// second, list-shaped view of exactly what's already on the timetable
// (nothing fabricated), which also happens to fill the width a five-day
// grid leaves spare once there's only a handful of sessions on it.
const timetableByDay = new Map<string, typeof timetable>();
for (const entry of timetable) {
  const list = timetableByDay.get(entry.offering.day) ?? [];
  list.push(entry);
  timetableByDay.set(entry.offering.day, list);
}
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Timetable</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header active="timetable" />
    <main>
      <h1>My timetable</h1>
      <p class="lede">
        Pick sessions from the offerings below. Adding one that overlaps a
        session already on your timetable is rejected on the spot, instead of
        letting you find out about the clash after enrolment.
      </p>

      {
        addedOffering && (
          <p role="status" class="toast toast-success">
            <span class="toast-icon material-symbols-outlined" aria-hidden="true">
              check_circle
            </span>
            <span class="toast-body">
              <strong>
                Added: {addedOffering.courseCode} {addedOffering.sessionType}
              </strong>
              <span>
                {addedOffering.day} {addedOffering.startTime}–{addedOffering.endTime}
              </span>
            </span>
          </p>
        )
      }
      {
        removedOffering && (
          <p role="status" class="toast toast-success">
            <span class="toast-icon material-symbols-outlined" aria-hidden="true">
              check_circle
            </span>
            <span class="toast-body">
              <strong>
                Removed: {removedOffering.courseCode} {removedOffering.sessionType}
              </strong>
              <span>
                {removedOffering.day} {removedOffering.startTime}–{removedOffering.endTime}
              </span>
            </span>
          </p>
        )
      }
      {
        clashOffering && (
          <p role="alert" class="toast toast-error">
            <span class="toast-icon material-symbols-outlined" aria-hidden="true">
              error
            </span>
            <span class="toast-body">
              <strong>
                {clashOffering.courseCode} {clashOffering.sessionType} was not added
              </strong>
              <span>
                ({clashOffering.day} {clashOffering.startTime}–{clashOffering.endTime}) clashes
                with{" "}
                {withOffering
                  ? `${withOffering.courseCode} ${withOffering.sessionType} (${withOffering.day} ${withOffering.startTime}–${withOffering.endTime})`
                  : "a session already on your timetable"}
                .
              </span>
            </span>
          </p>
        )
      }
      {
        cleared && (
          <p role="status" class="toast toast-success">
            <span class="toast-icon material-symbols-outlined" aria-hidden="true">
              check_circle
            </span>
            <span class="toast-body">
              <strong>Timetable cleared.</strong>
            </span>
          </p>
        )
      }
      {
        autoselected && conflictCourseCodes.length === 0 && (
          <p role="status" class="toast toast-success">
            <span class="toast-icon material-symbols-outlined" aria-hidden="true">
              check_circle
            </span>
            <span class="toast-body">
              <strong>One-click enrol complete</strong>
              <span>Added every course's Lecture and a non-clashing Lab.</span>
            </span>
          </p>
        )
      }
      {
        autoselected && conflictCourseCodes.length > 0 && (
          <p role="alert" class="toast toast-error">
            <span class="toast-icon material-symbols-outlined" aria-hidden="true">
              error
            </span>
            <span class="toast-body">
              <strong>Couldn't fit a Lab for {conflictCourseCodes.join(", ")}</strong>
              <span>
                Every Lab option left clashes with another course's. Try swapping one of these
                for a different course.
              </span>
            </span>
          </p>
        )
      }

      <div class="stats-bar">
        <div class="stat-card">
          <span class="stat-card-label">
            <span>Courses</span>
            <span class="material-symbols-outlined" aria-hidden="true">school</span>
          </span>
          <span class="stat-card-value">{distinctCourseCount}</span>
        </div>
        <div class="stat-card">
          <span class="stat-card-label">
            <span>Sessions</span>
            <span class="material-symbols-outlined" aria-hidden="true">event</span>
          </span>
          <span class="stat-card-value">{timetable.length}</span>
        </div>
        <div class="stat-card">
          <span class="stat-card-label">
            <span>Contact hours</span>
            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
          </span>
          <span class="stat-card-value">
            {totalContactHours}
            <small>hrs / week</small>
          </span>
        </div>
        <div class="stat-card stat-status">
          <span class="stat-card-label">
            <span>Status</span>
          </span>
          <span class="stat-card-value">
            <span class="material-symbols-outlined" aria-hidden="true">verified</span>
            Clash-free
          </span>
        </div>
      </div>

      <div class="layout">
        <aside class="sidebar" aria-labelledby="offerings-heading">
          <h2 id="offerings-heading">Available sessions</h2>
          <div id="offerings">
            {[...offeringsByCourse.entries()].map(([courseCode, sessions]) => (
              <details class="course-group" open={courseCode === openCourseCode || undefined}>
                <summary>{courseCode}</summary>
                <ul class="course-sessions">
                  {sessions.map((offering) => (
                    <li class={`type-${offering.sessionType.toLowerCase()}`}>
                      <strong class="session-type">
                        <span class="material-symbols-outlined" aria-hidden="true">
                          {sessionIcon(offering.sessionType)}
                        </span>
                        {offering.sessionType}
                      </strong>
                      <span>
                        {offering.day} {offering.startTime}–{offering.endTime}
                      </span>
                      <span class="session-location">
                        <span class="material-symbols-outlined" aria-hidden="true">
                          location_on
                        </span>
                        {offering.location}
                      </span>
                      {takenOfferingIds.has(offering.id) ? (
                        <span class="added-tag">
                          <span class="material-symbols-outlined" aria-hidden="true">
                            check
                          </span>
                          Added
                        </span>
                      ) : (
                        <form method="post" action="/api/timetable">
                          <input type="hidden" name="offeringId" value={offering.id} />
                          <button>Add</button>
                        </form>
                      )}
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </aside>

        <section class="timetable-panel" aria-labelledby="mine-heading">
          <div class="panel-header">
            <h2 id="mine-heading">On your timetable</h2>
            <div class="bulk-actions">
              <form method="post" action="/api/timetable-autoselect">
                <button type="submit">One-click enrol</button>
              </form>
              <form method="post" action="/api/timetable-clear">
                <button type="submit" class="button-secondary">Clear timetable</button>
              </form>
            </div>
          </div>
          {
            timetable.length === 0 && (
              <div class="empty-state">
                <span class="material-symbols-outlined" aria-hidden="true">
                  event_available
                </span>
                <p>
                  Nothing added yet. Pick a session from the list on the left, or use{" "}
                  <strong>One-click enrol</strong> above to fill your whole timetable in one go.
                </p>
              </div>
            )
          }
          <div
            id="timetable"
            style={`grid-template-columns: auto repeat(${GRID_DAYS.length}, 1fr); grid-template-rows: auto repeat(${GRID_ROWS}, 2rem);`}
          >
            <div class="grid-corner" style="grid-column: 1; grid-row: 1;" />
            {Array.from({ length: Math.ceil(GRID_ROWS / 2) }, (_, hourIndex) => hourIndex)
              .filter((hourIndex) => hourIndex % 2 === 0)
              .map((hourIndex) => (
                <div
                  class="grid-hour-band"
                  style={`grid-column: 1 / -1; grid-row: ${hourIndex * 2 + 2} / ${hourIndex * 2 + 4};`}
                />
              ))}
            {GRID_DAYS.map((day, i) => (
              <div class="grid-day-header" style={`grid-column: ${i + 2}; grid-row: 1;`}>
                {day}
              </div>
            ))}
            {slotLabels.map((label, i) => (
              <div class="grid-time-label" style={`grid-column: 1; grid-row: ${i + 2};`}>
                {label}
              </div>
            ))}
            {timetable.map((entry) => (
              <div
                class={`slot type-${entry.offering.sessionType.toLowerCase()}`}
                data-selection-id={entry.selectionId}
                style={`grid-column: ${GRID_DAYS.indexOf(entry.offering.day) + 2}; grid-row: ${timeToRow(
                  entry.offering.startTime,
                )} / ${timeToRow(entry.offering.endTime)};`}
              >
                <form method="post" action="/api/timetable-remove" class="remove-form">
                  <input type="hidden" name="selectionId" value={entry.selectionId} />
                  <button
                    type="submit"
                    aria-label={`Remove ${entry.offering.courseCode} ${entry.offering.sessionType}`}
                  >
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                  </button>
                </form>
                <span class="material-symbols-outlined slot-type-icon" aria-hidden="true">
                  {sessionIcon(entry.offering.sessionType)}
                </span>
                <strong>
                  {entry.offering.courseCode} {entry.offering.sessionType}
                </strong>
                <span>
                  {entry.offering.startTime}–{entry.offering.endTime}
                </span>
                <span>{entry.offering.location}</span>
              </div>
            ))}
          </div>
        </section>

        <aside class="agenda" aria-labelledby="agenda-heading">
          <h3 id="agenda-heading">Agenda</h3>
          {
            timetable.length === 0 ? (
              <p class="agenda-empty">Your sessions will be listed here once added.</p>
            ) : (
              GRID_DAYS.filter((day) => timetableByDay.has(day)).map((day) => (
                <div class="agenda-day">
                  <h4>{day}</h4>
                  <ul>
                    {timetableByDay.get(day)!.map((entry) => (
                      <li class={`agenda-item type-${entry.offering.sessionType.toLowerCase()}`}>
                        <span class="material-symbols-outlined" aria-hidden="true">
                          {sessionIcon(entry.offering.sessionType)}
                        </span>
                        <span class="agenda-item-body">
                          <strong>
                            {entry.offering.courseCode} {entry.offering.sessionType}
                          </strong>
                          <span>
                            {entry.offering.startTime}–{entry.offering.endTime} ·{" "}
                            {entry.offering.location}
                          </span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            )
          }
        </aside>
      </div>
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div>
          <strong>ANU Timetable Clash Checker</strong>
          <span>A COMP4020 prototype — not an official university system.</span>
        </div>
        <span>Built with Astro + SQLite.</span>
      </div>
    </footer>
    <script>
      // Live half of the app: a second open tab picks up an addition made in
      // the first over SSE. The form itself needs none of this — its
      // POST + redirect re-renders the submitting tab from SQLite.
      //
      // Submitting the Add/Remove form is a full navigation away from THIS
      // page, and the server broadcasts the SSE event for that very action
      // before the browser finishes tearing this page down. If this
      // soon-to-be-replaced page were still listening, it could catch its
      // own broadcast and reload itself — racing the in-flight navigation to
      // the redirect target, and sometimes winning: landing back on whatever
      // course group was open on THIS page instead of the target page's
      // correctly-expanded one (e.g. adding a COMP1100 session could flash
      // COMP4020 back open if that was open here beforehand). Closing the
      // connection the instant a form submits — synchronously, before any
      // network round-trip — removes the race instead of just narrowing it.
      const source = new EventSource("/api/events");
      document.addEventListener(
        "submit",
        () => {
          source.close();
        },
        { capture: true },
      );

      source.addEventListener("message", () => {
        location.reload();
      });

      // Cosmetic only: the toast itself is server-rendered from the redirect
      // query params, so it's fully functional with this script disabled —
      // it just stays on screen instead of fading out.
      const toast = document.querySelector(".toast");
      if (toast) setTimeout(() => toast.remove(), 4000);
    </script>
  </body>
</html>
